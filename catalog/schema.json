{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "XANTACatalogProduct",
  "description": "Product data schema for XANTA Reformia storefront catalog and D1 import",
  "type": "object",
  "required": ["id", "name", "category", "price", "description", "colourways"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique URL-friendly slug, e.g. xanta-mineral-wash-tee"
    },
    "name": {
      "type": "string",
      "description": "Product title displayed on storefront and detail pages"
    },
    "category": {
      "type": "string",
      "enum": ["T-SHIRT", "DENIM", "PANTS", "HOODIE", "ACCESSORIES", "POLO"],
      "description": "Product category for filtering and navigation"
    },
    "colour": {
      "type": "string",
      "description": "Default primary colourway name"
    },
    "price": {
      "type": "number",
      "minimum": 1,
      "description": "Retail price in USD"
    },
    "compare_at_price": {
      "type": ["number", "null"],
      "description": "Optional original price for sale display"
    },
    "description": {
      "type": "string",
      "description": "Editorial product description"
    },
    "details": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of garment features and fabric specifications"
    },
    "care": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Washing and garment care guidelines"
    },
    "sizes": {
      "type": "array",
      "items": { "type": "string" },
      "default": ["S", "M", "L", "XL"],
      "description": "Available garment sizes"
    },
    "published": {
      "type": "boolean",
      "default": true
    },
    "featured": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "integer",
      "default": 1
    },
    "colourways": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["colour", "images"],
        "properties": {
          "id": { "type": "string" },
          "colour": { "type": "string" },
          "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{3,8}$" },
          "images": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["url"],
              "properties": {
                "key": { "type": "string" },
                "url": { "type": "string" },
                "label": { "type": "string", "enum": ["Front", "Back", "Detail", "Side"] }
              }
            }
          }
        }
      }
    }
  }
}
